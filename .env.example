# ==============================================================================
# Model Provider Configuration for AI Text Humanizer Agent (ADK + LiteLLM)
# ==============================================================================

# --- OpenRouter Configuration ---
# Get an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- NVIDIA NIM Configuration ---
# Get an API key from https://build.nvidia.com
NVIDIA_API_KEY=

# --- Model Selection (LiteLLM format: provider/model-name) ---
# Recommended OpenRouter models:
#   openrouter/meta-llama/llama-3.3-70b-instruct (Top choice for burstiness & style nuance)
#   openrouter/qwen/qwen-2.5-72b-instruct
#   openrouter/deepseek/deepseek-chat
#   openrouter/mistralai/mistral-large-2411
#
# Recommended NVIDIA NIM models:
#   nvidia_nim/meta/llama-3.3-70b-instruct
#   nvidia_nim/mistralai/mixtral-8x22b-instruct-v0.1
#
HUMANIZER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct

# --- Optional Gemini Fallback ---
# If using Google Gemini directly:
GEMINI_API_KEY=
